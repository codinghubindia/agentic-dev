{
  "name": "ai-rag-project",
  "version": "1.1",
  "description": "Pipeline for Artificial Intelligence, LLM, and RAG (Retrieval-Augmented Generation) applications with mandatory integration assembly.",
  "execution": {
    "defaultModel": "inherit",
    "modelOverrides": {
      "technical-architect": "pro",
      "ai-ml-lead": "pro",
      "security-lead": "pro",
      "integration-manager": "pro",
      "documentation-agent": "flash"
    },
    "parallelismLimit": 3
  },
  "projectTypes": ["ai-rag"],
  "phases": [
    {
      "id": "phase_1_discovery",
      "name": "Discovery & Requirements",
      "skipConditions": ["user_skip_discovery"],
      "agents": ["software-intake-manager"],
      "requiredArtifacts": ["ai-requirements.md"],
      "hardGate": true
    },
    {
      "id": "phase_2_architecture",
      "name": "AI Architecture",
      "skipConditions": ["user_skip_architecture"],
      "agents": ["technical-architect", "ai-ml-lead"],
      "requiredArtifacts": ["ai-architecture.md", "data-pipeline-spec.md"],
      "hardGate": true
    },
    {
      "id": "phase_2_5_design",
      "name": "UI/UX Design",
      "skipConditions": ["api-only", "no_frontend", "user_skip_design"],
      "agents": ["uiux-lead"],
      "requiredArtifacts": ["design-system.md"],
      "hardGate": false
    },
    {
      "id": "phase_3_implementation",
      "name": "Parallel Implementation",
      "skipConditions": [],
      "agents": ["ai-ml-lead", "backend-lead", "data-lead", "frontend-lead"],
      "requiredArtifacts": ["ai_impl_complete_flag"],
      "hardGate": true
    },
    {
      "id": "phase_3_5_integration",
      "name": "Fullstack AI Integration & Assembly",
      "skipConditions": [],
      "leadAgent": "integration-manager",
      "agents": ["integration-manager", "ai-ml-lead", "backend-lead", "frontend-lead"],
      "requiredArtifacts": ["integration-report.json"],
      "hardGate": true,
      "dependsOn": ["phase_3_implementation"]
    },
    {
      "id": "phase_4_testing",
      "name": "AI Testing & Evaluation",
      "skipConditions": ["user_skip_testing"],
      "agents": ["qa-lead", "ai-ml-lead"],
      "requiredArtifacts": ["eval-benchmarks.md"],
      "hardGate": true,
      "dependsOn": ["phase_3_5_integration"]
    },
    {
      "id": "phase_5_security",
      "name": "Integration & Security",
      "skipConditions": ["user_skip_security"],
      "agents": ["security-lead"],
      "requiredArtifacts": ["ai-security-audit.md"],
      "hardGate": true
    },
    {
      "id": "phase_6_deployment",
      "name": "Deployment",
      "skipConditions": ["user_skip_deployment"],
      "agents": ["devops-release-lead"],
      "requiredArtifacts": ["deployment-success_flag"],
      "hardGate": true
    }
  ]
}
