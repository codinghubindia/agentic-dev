{
  "workflowId": "integration-and-release",
  "name": "Integration and Release Workflow",
  "description": "Standard operating procedure for merging parallel code streams, resolving conflicts, validating builds, running comprehensive test suites, and signing off on release.",
  "execution": {
    "defaultModel": "inherit",
    "modelOverrides": {
      "security-lead": "pro",
      "integration-manager": "pro",
      "release-notes-worker": "flash"
    },
    "parallelismLimit": 2
  },
  "phases": [
    {
      "id": "phase_1_harmonization",
      "name": "Source Tree Harmonization",
      "skipConditions": [],
      "agents": ["integration-manager"],
      "requiredArtifacts": [],
      "hardGate": true
    },
    {
      "id": "phase_2_integration_build",
      "name": "Integration Build & Unit Tests",
      "skipConditions": [],
      "agents": ["integration-manager"],
      "requiredArtifacts": [],
      "hardGate": true
    },
    {
      "id": "phase_3_e2e_regression",
      "name": "E2E and Regression Suite",
      "skipConditions": ["user_skip_testing"],
      "agents": ["qa-lead"],
      "requiredArtifacts": ["qa-report.json"],
      "hardGate": true
    },
    {
      "id": "phase_4_security_architecture",
      "name": "Security & Architecture Review",
      "skipConditions": [],
      "agents": ["security-lead"],
      "requiredArtifacts": ["security-signoff.md"],
      "hardGate": true
    },
    {
      "id": "phase_5_release_packaging",
      "name": "Release Packaging & Deployment",
      "skipConditions": ["user_skip_deployment"],
      "agents": ["devops-release-lead"],
      "requiredArtifacts": ["release-report.json", "CHANGELOG.md"],
      "hardGate": true
    }
  ],
  "steps": [
    {
      "step": 1,
      "name": "Source Tree Harmonization",
      "leadAgent": "integration-manager",
      "action": "Inspect branches/changes, check ownership adherence, detect file clashes",
      "requiredArtifacts": []
    },
    {
      "step": 2,
      "name": "Integration Build & Unit Tests",
      "leadAgent": "integration-manager",
      "action": "Execute build scripts and run core unit tests",
      "requiredArtifacts": []
    },
    {
      "step": 3,
      "name": "E2E and Regression Suite",
      "leadAgent": "qa-lead",
      "delegates": ["browser-e2e-tester"],
      "action": "Run full regression and browser end-to-end tests",
      "requiredArtifacts": []
    },
    {
      "step": 4,
      "name": "Security & Architecture Review",
      "leadAgent": "security-lead",
      "collaborators": ["code-reviewer", "technical-architect"],
      "action": "Audit codebase for vulnerabilities, secrets, and architecture compliance",
      "requiredArtifacts": []
    },
    {
      "step": 5,
      "name": "Release Packaging & Deployment",
      "leadAgent": "devops-release-lead",
      "artifacts": ["release-report.json", "CHANGELOG.md"],
      "requiredArtifacts": ["release-report.json", "CHANGELOG.md"]
    }
  ]
}
