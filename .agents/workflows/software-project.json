{
  "name": "software-project",
  "version": "2.0",
  "description": "Standard end-to-end software delivery lifecycle pipeline.",
  "projectTypes": ["fullstack", "frontend-only", "mobile-app", "api-only"],
  "phases": [
    {
      "id": "phase_1_requirements",
      "name": "Requirements & Architecture",
      "skipConditions": ["user_skip_requirements", "has_existing_architecture"],
      "agents": ["technical-architect"],
      "requiredArtifacts": ["architecture-blueprint.md", "api-contract.json"],
      "hardGate": true
    },
    {
      "id": "phase_2_database",
      "name": "Data Modeling",
      "skipConditions": ["no_database", "api-only_no_db", "frontend-only"],
      "agents": ["data-lead"],
      "requiredArtifacts": ["schema-design.md", "migrations.sql"],
      "hardGate": true
    },
    {
      "id": "phase_3_design",
      "name": "UI/UX Design",
      "skipConditions": ["api-only", "no_frontend", "user_skip_design"],
      "agents": ["uiux-lead"],
      "requiredArtifacts": ["design-system.md", "component-specs.md"],
      "hardGate": true
    },
    {
      "id": "phase_4_implementation",
      "name": "Core Implementation",
      "skipConditions": [],
      "agents": ["backend-lead", "frontend-lead", "mobile-lead"],
      "requiredArtifacts": ["implementation_complete_flag"],
      "hardGate": true,
      "dependsOn": ["phase_3_design"]
    },
    {
      "id": "phase_5_qa",
      "name": "Quality Assurance",
      "skipConditions": ["user_skip_testing"],
      "agents": ["qa-lead", "security-lead"],
      "requiredArtifacts": ["test-report.md", "security-signoff.md"],
      "hardGate": true
    },
    {
      "id": "phase_5_5_stress_testing",
      "name": "Performance & Stress Testing",
      "skipConditions": ["user_skip_stress_testing", "low_traffic_app"],
      "agents": ["performance-worker", "qa-lead"],
      "requiredArtifacts": ["performance-report.md"],
      "hardGate": false
    },
    {
      "id": "phase_6_deployment",
      "name": "Release & Deployment",
      "skipConditions": ["user_skip_deployment", "local_only"],
      "agents": ["devops-release-lead", "documentation-agent"],
      "requiredArtifacts": ["release-notes.md", "deployment-success_flag"],
      "hardGate": true
    }
  ]
}
