{
  "name": "codebase-update",
  "version": "2.0",
  "description": "Workflow for updates, refactors, and feature additions to existing codebases.",
  "projectTypes": ["fullstack", "frontend-only", "mobile-app", "api-only", "ai-rag", "automation", "game"],
  "phases": [
    {
      "id": "phase_1_analysis",
      "name": "Codebase Analysis",
      "skipConditions": [],
      "agents": ["technical-architect", "code-reviewer"],
      "requiredArtifacts": ["impact-analysis.md"],
      "hardGate": true
    },
    {
      "id": "phase_2_implementation",
      "name": "Implementation",
      "skipConditions": [],
      "agents": ["backend-lead", "frontend-lead", "mobile-lead"],
      "requiredArtifacts": ["update_complete_flag"],
      "hardGate": true
    },
    {
      "id": "phase_3_qa",
      "name": "Regression Testing",
      "skipConditions": ["user_skip_testing"],
      "agents": ["qa-lead", "regression-test-worker"],
      "requiredArtifacts": ["regression-report.md"],
      "hardGate": true
    },
    {
      "id": "phase_3_5_stress_testing",
      "name": "Performance Evaluation",
      "skipConditions": ["user_skip_stress_testing"],
      "agents": ["performance-worker"],
      "requiredArtifacts": ["performance-delta.md"],
      "hardGate": false
    },
    {
      "id": "phase_4_doc",
      "name": "Documentation Update",
      "skipConditions": ["user_skip_doc"],
      "agents": ["documentation-agent"],
      "requiredArtifacts": ["updated-docs_flag"],
      "hardGate": false
    },
    {
      "id": "phase_5_deployment",
      "name": "Deployment",
      "skipConditions": ["user_skip_deployment"],
      "agents": ["devops-release-lead"],
      "requiredArtifacts": ["deployment-success_flag"],
      "hardGate": true
    }
  ]
}
