{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainAbstracts",
  "type": "object",
  "required": ["version", "abstracts"],
  "properties": {
    "version": { "type": "integer", "default": 1 },
    "lastUpdated": { "type": "string", "format": "date-time" },
    "abstracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["owner", "domain", "filesOwned", "interfaceSummary"],
        "properties": {
          "owner": { "type": "string" },
          "domain": { "type": "string" },
          "filesOwned": {
            "type": "array",
            "items": { "type": "string" }
          },
          "interfaceSummary": {
            "type": "string",
            "description": "Dense, single-paragraph or markdown summary of types, exports, and contracts (< 120 words)"
          },
          "keyTypesOrEndpoints": {
            "type": "array",
            "items": { "type": "string" }
          },
          "gotchas": { "type": "string" }
        }
      }
    }
  }
}
