{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompactIntermediateRepresentation",
  "description": "Ultra-dense semantic specification for fullstack features, enabling 0-token deterministic scaffolding and eliminating LLM boilerplate typing.",
  "type": "object",
  "required": ["feature", "version", "entities", "operations"],
  "properties": {
    "feature": {
      "type": "string",
      "description": "Name of the feature or module"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "entities": {
      "type": "object",
      "description": "Entity models with fields and constraints",
      "additionalProperties": {
        "type": "object",
        "required": ["fields"],
        "properties": {
          "fields": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Field name to compact type notation (e.g. uuid!, string!unique, datetime, int?)"
          },
          "relations": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "indexes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "description": "API mutations, queries, or RPCs",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "input", "output", "action"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["query", "mutation", "subscription", "job"]
          },
          "auth": {
            "type": "string",
            "description": "Auth guard or permission (e.g. public, authenticated, admin)"
          },
          "input": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "output": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "guards": {
            "type": "array",
            "items": { "type": "string" }
          },
          "action": {
            "type": "string",
            "description": "Compact high-level semantic execution description"
          },
          "sideEffects": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
