{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact Intermediate Representation (CIR)",
  "description": "Dense schema defining feature contracts, entities, and endpoints without token bloat",
  "type": "object",
  "required": ["version", "projectName", "techStack", "entities", "endpoints", "fileBoundaries"],
  "properties": {
    "version": { "type": "string", "default": "7.0" },
    "projectName": { "type": "string" },
    "techStack": {
      "type": "object",
      "required": ["backend", "frontend", "database"],
      "properties": {
        "backend": { "type": "string" },
        "frontend": { "type": "string" },
        "database": { "type": "string" },
        "infra": { "type": "string" }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "properties": {
          "name": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path", "ownerWorker"],
        "properties": {
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string" },
          "auth": { "type": "boolean" },
          "ownerWorker": { "type": "string" },
          "contract": { "type": "object" }
        }
      }
    },
    "fileBoundaries": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
