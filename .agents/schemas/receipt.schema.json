{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ephemeral Strike Worker Receipt",
  "description": "Dense <50 token semantic receipt returned by ephemeral workers upon completion",
  "type": "object",
  "required": ["status", "exit_code", "action", "target", "receiptRef", "timestamp"],
  "properties": {
    "status": { "type": "string", "enum": ["success", "failed"] },
    "exit_code": { "type": "integer" },
    "action": { "type": "string" },
    "target": { "type": "string" },
    "summary": { "type": "string" },
    "metrics": {
      "type": "object",
      "properties": {
        "lines": { "type": "integer" },
        "bytes": { "type": "integer" }
      }
    },
    "receiptRef": { "type": "string" },
    "timestamp": { "type": "string" },
    "diagnostics": { "type": "object" }
  }
}
