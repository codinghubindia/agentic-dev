{
  "version": "1.0.0",
  "description": "Pre-seeded terminal command quirks. Learned entries are appended under learnedQuirks at runtime.",
  "quirks": {
    "powershell5": {
      "findBinary": "Get-Command {0} -ErrorAction SilentlyContinue",
      "checkFileExists": "Test-Path '{0}'",
      "appendToFile": "Add-Content -Path '{0}' -Value '{1}'",
      "getEnvVar": "$env:{0}",
      "redirectStderr": "2>$null",
      "grepInFile": "Select-String -Pattern '{0}' -Path '{1}'",
      "sedReplace": "(Get-Content '{0}') -replace '{1}', '{2}' | Set-Content '{0}'",
      "listDir": "Get-ChildItem '{0}'",
      "readFile": "Get-Content '{0}'",
      "writeFile": "Set-Content -Path '{0}' -Value '{1}'",
      "createDir": "New-Item -ItemType Directory -Force -Path '{0}'",
      "deleteFile": "Remove-Item '{0}' -Force",
      "which": "Get-Command {0} -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Source",
      "setEnvVar": "$env:{0} = '{1}'",
      "refreshPath": "$env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User')"
    },
    "powershell7": {
      "findBinary": "Get-Command {0} -ErrorAction SilentlyContinue",
      "checkFileExists": "Test-Path '{0}'",
      "appendToFile": "Add-Content -Path '{0}' -Value '{1}'",
      "getEnvVar": "$env:{0}",
      "redirectStderr": "2>$null",
      "grepInFile": "Select-String -Pattern '{0}' -Path '{1}'",
      "sedReplace": "(Get-Content '{0}') -replace '{1}', '{2}' | Set-Content '{0}'",
      "listDir": "Get-ChildItem '{0}'",
      "readFile": "Get-Content '{0}'",
      "writeFile": "Set-Content -Path '{0}' -Value '{1}'",
      "createDir": "New-Item -ItemType Directory -Force -Path '{0}'",
      "deleteFile": "Remove-Item '{0}' -Force",
      "which": "Get-Command {0} -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Source",
      "setEnvVar": "$env:{0} = '{1}'",
      "refreshPath": "$env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User')"
    },
    "bash": {
      "findBinary": "which {0}",
      "checkFileExists": "[ -f '{0}' ]",
      "appendToFile": "echo '{1}' >> '{0}'",
      "getEnvVar": "${0}",
      "redirectStderr": "2>/dev/null",
      "grepInFile": "grep -q '{0}' '{1}'",
      "sedReplace": "sed -i 's/{1}/{2}/g' '{0}'",
      "listDir": "ls '{0}'",
      "readFile": "cat '{0}'",
      "writeFile": "echo '{1}' > '{0}'",
      "createDir": "mkdir -p '{0}'",
      "deleteFile": "rm -f '{0}'",
      "which": "which {0}",
      "setEnvVar": "export {0}='{1}'",
      "refreshPath": "source ~/.bashrc"
    },
    "zsh": {
      "findBinary": "which {0}",
      "checkFileExists": "[ -f '{0}' ]",
      "appendToFile": "echo '{1}' >> '{0}'",
      "getEnvVar": "${0}",
      "redirectStderr": "2>/dev/null",
      "grepInFile": "grep -q '{0}' '{1}'",
      "sedReplace": "sed -i '' 's/{1}/{2}/g' '{0}'",
      "listDir": "ls '{0}'",
      "readFile": "cat '{0}'",
      "writeFile": "echo '{1}' > '{0}'",
      "createDir": "mkdir -p '{0}'",
      "deleteFile": "rm -f '{0}'",
      "which": "which {0}",
      "setEnvVar": "export {0}='{1}'",
      "refreshPath": "source ~/.zshrc"
    },
    "cmd": {
      "findBinary": "where {0}",
      "checkFileExists": "if exist '{0}'",
      "appendToFile": "echo {1} >> {0}",
      "getEnvVar": "%{0}%",
      "redirectStderr": "2>nul",
      "grepInFile": "findstr /i '{0}' '{1}'",
      "listDir": "dir '{0}'",
      "readFile": "type '{0}'",
      "createDir": "mkdir '{0}'",
      "deleteFile": "del /f '{0}'",
      "which": "where {0}",
      "setEnvVar": "set {0}={1}"
    }
  },
  "learnedQuirks": [],
  "sessionHistory": []
}
